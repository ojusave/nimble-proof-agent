{
  "name": "nimble-proof-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names agent,ui \".venv/bin/python app.py serve --port 8767\" \"next dev --hostname 127.0.0.1 --port 8765\"",
    "build": "next build",
    "start": "concurrently --kill-others --names agent,ui \".venv/bin/python app.py serve --port 8767\" \"node scripts/start_ui.mjs\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:ui": "playwright test --config tests/playwright.config.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/react-core": "1.83.0",
    "@copilotkit/runtime": "1.83.0",
    "@tanstack/react-query": "5.105.3",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
