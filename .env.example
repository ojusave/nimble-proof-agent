NIMBLE_API_KEY=
# Optional layout-aware PDF parsing (full PDF sent to LlamaParse).
LLAMA_CLOUD_API_KEY=
# Optional: separate Python API deployment (server-only).
# PROOF_BACKEND_URL=http://127.0.0.1:8767
# Optional UI transport alternative: sse. Default is CopilotKit.
# NEXT_PUBLIC_TRACE_TRANSPORT=sse
# Hosted single workspace: generated password, served only behind HTTPS.
# PROOF_PUBLIC_URL=https://your-domain.example (Render supplies RENDER_EXTERNAL_URL)
# PROOF_ACCESS_USER=proof
# PROOF_ACCESS_PASSWORD=use-a-random-secret-of-at-least-24-characters
# PROOF_DATA_DIR=/var/data/proof
